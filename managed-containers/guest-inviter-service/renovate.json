{
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^managed-containers/guest-updater-service/Dockerfile$"
      ],
      "matchStrings": [
        "SOURCE_REPOSITORY=\"(?<depName>https://[^\"]+)\"\\s*\\\\\\s*SOURCE_REF=\"(?<currentValue>[^\"]+)\"\\s*\\\\\\s*SOURCE_SHA=\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "git"
    }
  ]
}
