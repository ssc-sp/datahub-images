{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "local>ssc-sp/datahub-images//managed-containers/guest-inviter-service/renovate.json"
  ],
  "hostRules": [
    {
      "matchHost": "artifacts-artefacts.devops.cloud-nuage.canada.ca",
      "token": "{{ env.JFROG_ACCESS_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "description": "Automatically group all dependencies by their parent folder",
      "matchFileNames": ["managed-containers/**"],
      "groupName": "{{packageFileDir}} dependencies"
    }
  ]
}
